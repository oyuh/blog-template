---
import type { CollectionEntry } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getTechnologyUsage } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { getTechIconName, techSlug } from "@/utils/techIcons";
import { Icon } from "astro-icon/components";

const allPosts = await getAllPosts();
const postsById = new Map(allPosts.map((post) => [post.id, post]));
const usage = getTechnologyUsage(allPosts);

const techGroups = Object.values(usage)
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
	.map((u) => ({
		name: u.name,
		slug: techSlug(u.name),
		count: u.count,
		icon: getTechIconName(u.name),
		posts: u.projects
			.map((p) => postsById.get(p.id))
			.filter((post): post is CollectionEntry<"post"> => post !== undefined),
	}));

// Latest few posts per group; the rest live on the detail page.
const SHOWN = 3;

const meta = {
	description: "Explore the technologies I build with and jump into the posts that use them.",
	title: "All Tech",
};

export const prerender = true;
---

<PageLayout meta={meta}>
	<div data-pagefind-ignore="all">
		<div class="mb-10 space-y-3">
			<h1 class="title text-3xl">Tech</h1>
			<p class="max-w-2xl text-base text-global-text/80 dark:text-global-text/70">
				The tools and frameworks I build with, and the posts where I actually use them.
			</p>
		</div>
		<div class="index-groups">
			{
				techGroups.map(({ name, slug, count, icon, posts }) => (
					<section aria-label={name}>
						<div class="index-group__head">
							<h2 class="index-group__title">
								<a class="index-group__name" data-astro-prefetch href={`/tech/${slug}/`}>
									<Icon aria-hidden="true" class="index-group__icon" focusable="false" name={icon} />
									<span class="hl-hover">{name}</span>
								</a>
								<span class="index-group__count">{count}</span>
							</h2>
							{count > SHOWN && (
								<a class="index-group__all underline-hover" data-astro-prefetch href={`/tech/${slug}/`}>
									View all →
								</a>
							)}
						</div>
						<ul role="list">
							{posts.slice(0, SHOWN).map((post) => (
								<li>
									<PostPreview as="h3" post={post} tip={false} />
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</div>
</PageLayout>
