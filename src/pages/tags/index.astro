---
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const tagGroups = allTags.map(([tag, count]) => ({
	tag,
	count,
	posts: allPosts
		.filter((post) => post.data.tags.includes(tag))
		.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()),
}));

// Latest few posts per group; the rest live on the detail page.
const SHOWN = 3;

const meta = {
	description: "Explore every tag on the site and jump into recent posts that use it.",
	title: "All Tags",
};
---

<PageLayout meta={meta}>
	<div data-pagefind-ignore="all">
		<div class="mb-10 space-y-3">
			<h1 class="title text-3xl">Tags</h1>
			<p class="max-w-2xl text-base text-global-text/80 dark:text-global-text/70">
				Every topic I write about, and the posts filed under it.
			</p>
		</div>
		<div class="index-groups">
			{
				tagGroups.map(({ tag, count, posts }) => (
					<section aria-label={`#${tag}`}>
						<div class="index-group__head">
							<h2 class="index-group__title">
								<a class="index-group__name" data-astro-prefetch href={`/tags/${tag}/`}>
									<span class="hl-hover">#{tag}</span>
								</a>
								<span class="index-group__count">{count}</span>
							</h2>
							{count > SHOWN && (
								<a class="index-group__all underline-hover" data-astro-prefetch href={`/tags/${tag}/`}>
									View all →
								</a>
							)}
						</div>
						<ul role="list">
							{posts.slice(0, SHOWN).map((post) => (
								<li>
									<PostPreview as="h3" post={post} tip={false} />
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</div>
</PageLayout>
