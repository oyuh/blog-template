---
import Search from "@/components/Search.astro";
import ThemeToggleOptional from "@/components/ThemeToggleOptional.astro";

// Flat, non-sticky header: search on the left, everything else on the right.
const pathname = Astro.url.pathname;
const isActive = (path: string) => pathname === path || pathname.startsWith(path);

const navLinks = [
	{ path: "/about/", title: "About" },
	{ path: "/posts/", title: "Posts" },
];
---

<header class="w-full pt-5 pb-3 sm:pt-6" id="site-header">
	<nav aria-label="Main menu" class="flex items-center justify-between gap-3">
		<div class="flex min-w-0 flex-1 items-center gap-2">
			<Search />
			{
				pathname !== "/" && (
					<a href="/" class="nav-icon" data-ti-home aria-label="Home" title="Home">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.7"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M3 11.5 12 4l9 7.5" />
							<path d="M5 10v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9" />
							<path d="M9.5 20v-5.5h5V20" />
						</svg>
					</a>
				)
			}
			{/* Takes the Home slot while Tech Invaders is running (TechInvaders.vue). */}
			<button type="button" class="nav-exit" data-ti-exit hidden>
				<span class="nav-exit__kbd" aria-hidden="true">Esc</span>
				Go Back
			</button>
		</div>
		<div class="flex flex-none items-center gap-1 sm:gap-2">
			{
				navLinks.map((link) => (
					<a
						href={link.path}
						aria-current={isActive(link.path) ? "page" : undefined}
						class:list={[
							"nav-link rounded-md px-2.5 py-1.5 text-base sm:text-lg font-medium tracking-wide",
							isActive(link.path) ? "text-accent" : "text-global-text",
						]}
					>
						{link.title}
					</a>
				))
			}
			<ThemeToggleOptional />
		</div>
	</nav>
</header>

<style>
	/* Home icon button (shown when off the home page) — bare icon, accent on hover. */
	.nav-icon {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		height: 2.25rem;
		width: 2.25rem;
		border-radius: 0.25rem;
		color: var(--color-global-text);
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.nav-icon:hover,
	.nav-icon:focus-visible {
		color: var(--color-accent);
		transform: scale(1.08);
		outline: none;
	}

	.nav-icon svg {
		height: 1.4rem;
		width: 1.4rem;
	}

	.nav-icon[hidden] {
		display: none;
	}

	/* Swapped in for the Home icon while the game is running — same bordered
	   button as the policy pages, with the site's usual keycap in front. */
	.nav-exit {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 0.45rem;
		height: 2.25rem;
		padding: 0 0.7rem;
		border: 1px solid color-mix(in srgb, var(--color-global-text) 15%, transparent);
		border-radius: 0.25rem;
		background: var(--color-global-bg);
		cursor: pointer;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--color-global-text);
		transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
	}

	.nav-exit[hidden] {
		display: none;
	}

	.nav-exit:hover,
	.nav-exit:focus-visible {
		border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
		background: color-mix(in srgb, var(--color-accent) 5%, var(--color-global-bg));
		color: var(--color-accent);
		outline: none;
	}

	.nav-exit__kbd {
		font-family: "Geist Mono Variable", ui-monospace, monospace;
		font-size: 0.68rem;
		padding: 0.05rem 0.35rem;
		border: 1px solid color-mix(in srgb, var(--color-global-text) 25%, transparent);
		border-radius: 0.3rem;
		color: color-mix(in srgb, var(--color-global-text) 70%, transparent);
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.nav-exit:hover .nav-exit__kbd,
	.nav-exit:focus-visible .nav-exit__kbd {
		border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
		color: var(--color-accent);
	}

	/* No keyboard on touch — the label alone is the exit there. */
	@media (max-width: 767px) {
		.nav-exit__kbd {
			display: none;
		}
	}

	:global(html.ti-playing) [data-ti-home] {
		display: none;
	}

	/* Narrow screens can't fit both search and the exit; search is dead weight
	   mid-game, so it gives up its room. */
	@media (max-width: 767px) {
		:global(html.ti-playing .site-search) {
			display: none;
		}
	}

	/* While the game runs the page is frozen where it was, so the header is
	   lifted back to the top of the viewport instead of scrolling the page under
	   it — nothing on screen moves on the way in or out. Opaque and above the
	   overlay, since the frozen page is still sitting behind it. */
	:global(html.ti-playing) #site-header {
		position: relative;
		z-index: 201;
		translate: 0 var(--ti-scroll, 0px);
		background: var(--color-global-bg);
	}

	/* Hover = underline, not a colour change (matches the rest of the site). */
	.nav-link {
		text-decoration: none;
		text-underline-offset: 4px;
		text-decoration-thickness: 2px;
	}

	.nav-link:hover,
	.nav-link:focus-visible {
		text-decoration: underline;
	}
</style>
