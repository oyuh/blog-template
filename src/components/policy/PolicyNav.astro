---
type PolicyPage = "info" | "privacy" | "terms";

const { current, updated } = Astro.props as { current: PolicyPage; updated: string };

const links = [
  { id: "info", href: "/policy/", label: "Policy Info" },
  { id: "privacy", href: "/policy/privacy/", label: "Privacy Policy" },
  { id: "terms", href: "/policy/tos/", label: "Terms of Service" },
];
---

<nav aria-label="Policy pages" class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
  <span class="text-global-text/55">Updated {updated}</span>
  {
    links.map((link) => (
      <>
        <span aria-hidden="true" class="text-global-text/30">•</span>
        {link.id === current ? (
          <span aria-current="page" class="font-medium text-accent-2">{link.label}</span>
        ) : (
          <a class="underline-hover font-medium text-accent" href={link.href}>{link.label}</a>
        )}
      </>
    ))
  }
</nav>
