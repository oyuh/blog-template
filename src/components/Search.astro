---
// Inline header search powered by the Pagefind JS API (no modal). A magnifier
// and an underline to type on, with a Filters toggle beside it. Tags + Tech
// filters and results drop below as two separate swatches. Dismiss by clicking
// outside or pressing Escape. Pagefind only exists in a production build, so dev
// shows a note in place of results.
import { getAllPosts } from "@/data/post";
import { getTechIconName } from "@/utils/techIcons";
import { Icon } from "astro-icon/components";
import "@/styles/blocks/search.css";

// Filter values and counts come from the same post data that Masthead tags with
// data-pagefind-filter, so they match the Pagefind index and render instantly.
const posts = await getAllPosts();
const countBy = (values: string[][]) => {
	const counts = new Map<string, number>();
	for (const v of values.flatMap((list) => [...new Set(list)])) counts.set(v, (counts.get(v) ?? 0) + 1);
	return [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
};
const groups = [
	{ key: "tag", title: "Tags", entries: countBy(posts.map((p) => p.data.tags ?? [])) },
	{
		key: "tech",
		title: "Tech",
		entries: countBy(posts.map((p) => (p.data.technologies ?? []).map((t) => t.trim()).filter(Boolean))),
	},
];
---

<site-search id="search" class="site-search">
	<div class="site-search__bar">
		<label class="site-search__field">
			<svg
				class="site-search__icon"
				aria-hidden="true"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.7"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<circle cx="11" cy="11" r="7"></circle>
				<path d="M21 21l-4.3-4.3"></path>
			</svg>
			<span class="site-search__line">
				<input
					type="search"
					class="site-search__input"
					placeholder="Search"
					aria-label="Search the site"
					aria-keyshortcuts="Control+K"
					autocomplete="off"
					spellcheck="false"
					data-input
				/>
				<button type="button" class="site-search__clear" data-clear hidden aria-label="Clear search">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M6 6l12 12M18 6L6 18"></path>
					</svg>
				</button>
			</span>
		</label>
		<span class="site-search__filter-ctl">
			<button type="button" class="site-search__text-btn site-search__filter-toggle" data-filter-toggle aria-expanded="false">Filters</button>
			<button type="button" class="site-search__clear" data-clear-filters hidden aria-label="Clear filters">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</span>
	</div>

	<div class="site-search__drop">
		<div class="site-search__swatch site-search__filters" data-filters hidden role="group" aria-label="Search filters">
			{groups.map(({ key, title, entries }) => (
				<div class="site-search__filter-group" data-group>
					<h4 class="site-search__filter-title">{title}</h4>
					<div class="site-search__chips">
						{entries.length === 0 && <span class="site-search__chips-empty">None</span>}
						{entries.map(([value, count]) => (
							<button type="button" class="site-search__chip" data-filter={key} data-value={value} aria-pressed="false">
								{key === "tech" && <Icon aria-hidden="true" class="site-search__chip-icon" name={getTechIconName(value)} />}
								{key === "tag" ? `#${value}` : value}
								<span class="site-search__chip-count">{count}</span>
							</button>
						))}
						<button type="button" class="site-search__more" data-more hidden aria-expanded="false" aria-label={`Show all ${title.toLowerCase()}`}>…</button>
					</div>
				</div>
			))}
		</div>

		<div class="site-search__swatch site-search__panel" data-panel hidden role="region" aria-label="Search results">
			<p class="site-search__status" data-status aria-live="polite"></p>
			<div class="site-search__results" data-results></div>
		</div>
	</div>
</site-search>

<script>
	const MAX_RESULTS = 6;
	const COLLAPSE_AFTER = 10_000; // ms an expanded filter row stays open without hover or keyboard focus
	const DEV = import.meta.env.DEV;
	const PAGEFIND_PATH = import.meta.env.BASE_URL.replace(/\/$/, "") + "/pagefind/pagefind.js";

	type SubResult = { title: string; url: string; excerpt: string; locations?: number[] };
	type ResultData = {
		url: string;
		meta?: { title?: string };
		excerpt: string;
		sub_results?: SubResult[];
	};

	const escapeHtml = (s: string) =>
		s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] as string);

	class SiteSearch extends HTMLElement {
		#input = this.querySelector<HTMLInputElement>("[data-input]");
		#clear = this.querySelector<HTMLButtonElement>("[data-clear]");
		#panel = this.querySelector<HTMLElement>("[data-panel]");
		#results = this.querySelector<HTMLElement>("[data-results]");
		#status = this.querySelector<HTMLElement>("[data-status]");
		#filterToggle = this.querySelector<HTMLButtonElement>("[data-filter-toggle]");
		#filters = this.querySelector<HTMLElement>("[data-filters]");
		#clearFilters = this.querySelector<HTMLButtonElement>("[data-clear-filters]");
		#pagefind: any = null;
		#loadingPagefind = false;
		#selected: { tag: Set<string>; tech: Set<string> } = { tag: new Set(), tech: new Set() };
		#debounce = 0;
		#collapseTimer = 0;
		#token = 0;
		#controller = new AbortController();

		connectedCallback() {
			const signal = this.#controller.signal;
			this.#input?.addEventListener("input", this.onInput, { signal });
			this.#input?.addEventListener("focus", this.onFocus, { signal });
			this.#clear?.addEventListener("click", this.onClear, { signal });
			this.#filterToggle?.addEventListener("click", this.onToggleFilters, { signal });
			this.#clearFilters?.addEventListener("click", this.onClearFilters, { signal });
			this.#filters?.addEventListener("click", this.onChipClick, { signal });
			this.#filters?.addEventListener("pointerleave", this.armCollapse, { signal });
			document.addEventListener("click", this.onDocClick, { signal });
			document.addEventListener("keydown", this.onKeydown, { signal });
		}

		disconnectedCallback() {
			this.#controller.abort();
			clearTimeout(this.#debounce);
			clearTimeout(this.#collapseTimer);
		}

		async loadPagefind() {
			if (this.#pagefind || this.#loadingPagefind) return this.#pagefind;
			this.#loadingPagefind = true;
			try {
				this.#pagefind = await import(/* @vite-ignore */ PAGEFIND_PATH);
				await this.#pagefind.options?.({ excerptLength: 18 });
			} catch {
				this.#pagefind = null;
			} finally {
				this.#loadingPagefind = false;
			}
			return this.#pagefind;
		}

		buildFilters() {
			const out: Record<string, string[]> = {};
			if (this.#selected.tag.size > 0) out.tag = [...this.#selected.tag];
			if (this.#selected.tech.size > 0) out.tech = [...this.#selected.tech];
			return out;
		}

		selectedCount() {
			return this.#selected.tag.size + this.#selected.tech.size;
		}

		onFocus = () => {
			if (!DEV) this.loadPagefind();
			this.setAttribute("data-open", "true");
			this.refresh();
		};

		onInput = () => {
			const value = this.#input?.value ?? "";
			if (this.#clear) this.#clear.hidden = value.length === 0;
			clearTimeout(this.#debounce);
			this.#debounce = window.setTimeout(() => this.refresh(), 180);
		};

		// Re-run search from the current query + selected filters. The results
		// swatch only shows once there is something to search for.
		refresh = async () => {
			const query = (this.#input?.value ?? "").trim();
			const filters = this.buildFilters();
			const hasFilters = Object.keys(filters).length > 0;
			const token = ++this.#token;
			if (this.#panel) this.#panel.hidden = !query && !hasFilters;
			if (!query && !hasFilters) return;

			if (DEV) {
				this.setStatus("");
				this.renderMessage("Search runs on the built site. Try it after a production build.");
				return;
			}

			const pf = await this.loadPagefind();
			if (token !== this.#token) return;
			if (!pf) {
				this.setStatus("");
				this.renderMessage("Search isn’t available right now.");
				return;
			}

			const search = await pf.search(query || null, hasFilters ? { filters } : undefined);
			if (token !== this.#token) return;
			const total: number = search.results.length;
			const data: ResultData[] = await Promise.all(
				search.results.slice(0, MAX_RESULTS).map((r: any) => r.data()),
			);
			if (token !== this.#token) return;
			this.setStatus(
				total === 0 ? "" : total > data.length ? `Top ${data.length} of ${total}` : `${total} result${total === 1 ? "" : "s"}`,
			);
			this.renderResults(data);
		};

		setStatus(text: string) {
			if (this.#status) this.#status.textContent = text;
		}

		renderMessage(message: string) {
			if (this.#results) this.#results.innerHTML = `<p class="site-search__message">${message}</p>`;
		}

		renderResults(data: ResultData[]) {
			if (!this.#results) return;
			if (data.length === 0) {
				this.#results.innerHTML = `<p class="site-search__message">No results.</p>`;
				return;
			}
			// One row per page: title, the best-matching section, one line of context.
			// Rows are added after Base.astro's tilt pass, so each gets its own tilt here.
			this.#results.innerHTML = data
				.map((d) => {
					// Pagefind lists sections in page order; take the one with the most hits.
				const sub =
					(d.sub_results ?? [])
						.filter((r) => r.url !== d.url)
						.sort((a, b) => (b.locations?.length ?? 0) - (a.locations?.length ?? 0))[0] ?? null;
					const href = escapeHtml(sub?.url ?? d.url);
					const title = escapeHtml(d.meta?.title || d.url);
					const section = sub ? `<span class="site-search__result-section">› ${escapeHtml(sub.title)}</span>` : "";
					const tilt = ((Math.random() < 0.5 ? -1 : 1) * (0.4 + Math.random() * 0.6)).toFixed(2);
					return `<a class="site-search__result" href="${href}"><span class="site-search__result-title hl-hover" style="--hl-tilt:${tilt}deg">${title}</span>${section}<p class="site-search__result-excerpt">${sub?.excerpt ?? d.excerpt}</p></a>`;
				})
				.join("");
		}

		// Collapsed, a row shows only the chips that fit on one line, then "…".
		// Expanded, every chip shows and "…" folds the row back up.
		fitGroup(group: HTMLElement) {
			const chips = [...group.querySelectorAll<HTMLElement>(".site-search__chip")];
			const more = group.querySelector<HTMLElement>("[data-more]");
			if (!more || chips.length === 0) return;
			const expanded = group.hasAttribute("data-expanded");
			for (const c of chips) c.hidden = false;
			more.hidden = !expanded;
			more.setAttribute("aria-expanded", String(expanded));
			const first = chips[0]!;
			const wrapped = (el: HTMLElement) => el.offsetTop >= first.offsetTop + first.offsetHeight;
			if (expanded || !wrapped(chips.at(-1)!)) return;
			more.hidden = false;
			for (let i = chips.length - 1; i > 0 && wrapped(more); i--) chips[i]!.hidden = true;
		}

		fitGroups() {
			this.#filters?.querySelectorAll<HTMLElement>("[data-group]").forEach((g) => this.fitGroup(g));
		}

		// Expanded rows fold back up after COLLAPSE_AFTER without hover or keyboard focus.
		armCollapse = () => {
			clearTimeout(this.#collapseTimer);
			if (!this.#filters?.querySelector("[data-expanded]")) return;
			this.#collapseTimer = window.setTimeout(() => {
				// A mouse click leaves focus on the "…" too, so only keyboard focus holds it open.
				if (this.#filters?.matches(":hover, :has(:focus-visible)")) return this.armCollapse();
				this.#filters?.querySelectorAll("[data-expanded]").forEach((g) => g.removeAttribute("data-expanded"));
				this.fitGroups();
			}, COLLAPSE_AFTER);
		};

		onChipClick = (e: MouseEvent) => {
			const target = e.target as HTMLElement;
			const group = target.closest<HTMLElement>("[data-group]");
			if (target.closest("[data-more]") && group) {
				group.toggleAttribute("data-expanded");
				this.fitGroup(group);
				this.armCollapse();
				return;
			}
			const chip = target.closest<HTMLElement>(".site-search__chip");
			if (!chip) return;
			const key = chip.dataset.filter;
			const value = chip.dataset.value ?? "";
			if (key !== "tag" && key !== "tech") return;
			const set = this.#selected[key];
			if (set.has(value)) set.delete(value);
			else set.add(value);
			chip.classList.toggle("is-active", set.has(value));
			chip.setAttribute("aria-pressed", String(set.has(value)));
			this.syncFilterChrome();
			this.refresh();
		};

		syncFilterChrome() {
			const count = this.selectedCount();
			if (this.#filterToggle) this.#filterToggle.textContent = count > 0 ? `Filters (${count})` : "Filters";
			if (this.#clearFilters) this.#clearFilters.hidden = count === 0;
			this.#filterToggle?.classList.toggle("is-active", count > 0);
		}

		setFiltersOpen(open: boolean) {
			if (!this.#filters || !this.#filterToggle) return;
			this.#filters.hidden = !open;
			this.#filterToggle.setAttribute("aria-expanded", String(open));
			if (open) this.fitGroups();
		}

		onToggleFilters = () => {
			this.setAttribute("data-open", "true");
			this.setFiltersOpen(!!this.#filters?.hidden);
		};

		onClearFilters = () => {
			this.#selected.tag.clear();
			this.#selected.tech.clear();
			this.querySelectorAll(".site-search__chip.is-active").forEach((c) => {
				c.classList.remove("is-active");
				c.setAttribute("aria-pressed", "false");
			});
			this.syncFilterChrome();
			this.#filterToggle?.focus(); // the × that had focus is now hidden
			this.refresh();
		};

		close() {
			if (this.#panel) this.#panel.hidden = true;
			this.setFiltersOpen(false);
			this.removeAttribute("data-open");
		}

		onClear = () => {
			if (this.#input) this.#input.value = "";
			if (this.#clear) this.#clear.hidden = true;
			this.setStatus("");
			this.refresh();
			this.#input?.focus();
		};

		// Click anywhere outside the search component → close it. composedPath() is
		// fixed at dispatch, so it still holds a clicked node that an earlier
		// handler hid or detached.
		onDocClick = (e: MouseEvent) => {
			if (e.composedPath().includes(this)) return;
			this.close();
		};

		onKeydown = (e: KeyboardEvent) => {
			if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
				e.preventDefault();
				this.#input?.focus();
				this.#input?.select();
				return;
			}
			if (e.key === "Escape" && this.hasAttribute("data-open")) {
				this.close();
				this.#input?.blur();
			}
		};
	}

	if (!customElements.get("site-search")) customElements.define("site-search", SiteSearch);
</script>
