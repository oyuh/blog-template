---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import PostTip from "@/components/blog/PostTip.astro";
import { calculateReadingTime } from "@/utils/readingTime";
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	/** Show the tilted preview card on hover. */
	tip?: boolean;
	withDesc?: boolean;
};

const { post, as: Tag = "div", tip = true } = Astro.props;

// "5 min read" → "5 min" for the compact meta column.
const readMinutes = calculateReadingTime(post).replace(/ read$/, "");
---

<div class:list={["post-row", { "post-tip-host": tip }]}>
	<a href={`/posts/${post.id}/`} data-astro-prefetch class="post-row__link" data-pagefind-body={true}>
		<Tag class="post-row__title">
			<span class="hl-hover">{post.data.title}</span>
		</Tag>
		<span class="post-row__date">
			{post.data.draft && <span class="post-row__draft">Draft</span>}
			<span>{readMinutes}</span>
			<span aria-hidden="true">·</span>
			<FormattedDate
				date={post.data.publishDate}
				dateTimeOptions={{ day: "numeric", month: "short", year: "numeric" }}
			/>
		</span>
	</a>
	{tip && <PostTip post={post} />}
</div>

<style>
	.post-row__link {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.25rem;
		padding: 0.7rem 0.25rem;
		border-top: 1px solid color-mix(in srgb, var(--color-global-text) 12%, transparent);
		text-decoration: none;
	}

	.post-row__title {
		margin: 0;
		min-width: 0;
		font-size: 1.05rem;
		font-weight: 500;
		line-height: 1.35;
		color: var(--color-accent-2);
	}

	.post-row__date {
		flex: none;
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.8rem;
		font-variant-numeric: tabular-nums;
		color: color-mix(in srgb, var(--color-global-text) 55%, transparent);
		white-space: nowrap;
	}

	.post-row__draft {
		font-weight: 700;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-red-500, oklch(62% 0.18 25));
	}
</style>
